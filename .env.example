# Copy to .dev.vars for local Workers development. Never commit secrets.
GEMINI_API_KEY=
OPENAI_API_KEY=
FOUNDRY_MODEL=gemini-3.8-flash
# Optional prices supplied by your deployment operator; USD per million tokens.
# Without both prices, dollar cost is reported as unknown, never zero.
FOUNDRY_INPUT_PRICE_PER_MILLION=
FOUNDRY_OUTPUT_PRICE_PER_MILLION=
