# Copy to .dev.vars for local Workers development. Never commit secrets.
FOUNDRY_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://127.0.0.1:3000
OPENROUTER_APP_NAME=Agent Foundry
FOUNDRY_MODEL=openai/gpt-4o
# Optional legacy providers. Set FOUNDRY_PROVIDER=gemini to use Gemini.
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional prices supplied by your deployment operator; USD per million tokens.
# OpenRouter uses reported billed cost; these overrides apply to legacy providers.
# Unknown billing is reported as unknown, never zero.
FOUNDRY_INPUT_PRICE_PER_MILLION=
FOUNDRY_OUTPUT_PRICE_PER_MILLION=
# App access: users authorize individual accounts from Settings.
COMPOSIO_API_KEY=
# Optional remote observability. Local traces always work.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agent-foundry
LANGSMITH_TRACE_CONTENT=false
